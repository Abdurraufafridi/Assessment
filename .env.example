# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Proposal Research Agent
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console
API_HOST=127.0.0.1
API_PORT=8000

# ---------------------------------------------------------------------------
# Structured persistence (SQLite now, PostgreSQL later)
# Examples:
#   sqlite:///./data/assessment.db
#   postgresql+psycopg://user:password@localhost:5432/proposal_agent
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/assessment.db

# ---------------------------------------------------------------------------
# LLM provider
# LLM_PROVIDER must be "gemini", "openrouter", or "ollama".
# Model names intentionally have no application defaults; set them here.
# Gemini 3.5 Flash is deprecated; this example uses the current stable model.
# OpenRouter's NVIDIA Nemotron 3 Ultra free endpoint is shown as an alternative.
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=2048

# ---------------------------------------------------------------------------
# Embeddings (local sentence-transformers)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------------------------
# Vector store (ChromaDB persistent client)
# ---------------------------------------------------------------------------
VECTOR_STORE_PROVIDER=chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=proposal_sections

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
INGESTION_CHUNK_SIZE=1000
INGESTION_CHUNK_OVERLAP=150
INGESTION_MIN_CHUNK_SIZE=100
INGESTION_BOUNDARY_SEARCH_CHARS=200
INGESTION_MAX_FILE_SIZE_MB=20

# ---------------------------------------------------------------------------
# Generated DOCX documents
# DOCUMENT_TEMPLATE_NAME must be a built-in name ("professional" or "minimal")
# or a custom name when DOCUMENT_TEMPLATE_PATH points to a base .docx file.
# ---------------------------------------------------------------------------
DOCUMENT_STORAGE_DIR=./data/generated
DOCUMENT_TEMPLATE_NAME=professional
DOCUMENT_TEMPLATE_PATH=

# ---------------------------------------------------------------------------
# Slack (Socket Mode for local development; signing secret supports a future
# HTTP Events API deployment)
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
